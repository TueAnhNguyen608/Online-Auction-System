<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: #0c1535;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.ui.bidding.AutoBidPanel">

    <top>
        <VBox style="-fx-background-color: #0c1535;">
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0e1c40; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0; -fx-min-height: 52; -fx-pref-height: 52;">
                <padding><Insets bottom="8" left="24" right="30" top="8" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <Label prefHeight="44.0" prefWidth="261.0" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #F5C518;" text="HỆ THỐNG ĐẤU GIÁ">
                        <graphic>
                            <ImageView fitHeight="46.0" fitWidth="50.0" preserveRatio="true">
                                <image><Image url="@../../icons/bua1.png" /></image>
                            </ImageView>
                        </graphic>
                    </Label>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #0e1c40; -fx-background-radius: 20; -fx-border-color: #2A4A6E; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 4 12 4 8; -fx-cursor: hand;">
                    <ImageView fitHeight="22" fitWidth="24" preserveRatio="true">
                        <image><Image url="@../../icons/user.png" /></image>
                    </ImageView>
                    <Label fx:id="lblUserName" style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold;" text="User" />
                    <Label style="-fx-text-fill: #A0C4E8; -fx-font-size: 11px;" text="▾" />
                </HBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: #162550; -fx-min-height: 46; -fx-pref-height: 46; -fx-border-color: #11224a; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="0" left="24" right="30" top="0" /></padding>
                <Button fx:id="btnTabDanhSach" onAction="#onTabDanhSach" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7 14 7 14; -fx-background-radius: 4 4 0 0; -fx-border-color: #1b2f5e; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="DANH SÁCH">
                    <graphic><ImageView fitHeight="38.0" fitWidth="25.0" preserveRatio="true"><image><Image url="@../../icons/1.3.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="btnTabDauGia" onAction="#onTabDauGia" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7 14 7 14; -fx-background-radius: 4 4 0 0; -fx-border-color: #1b2f5e; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ">
                    <graphic><ImageView fitHeight="41.0" fitWidth="25.0" preserveRatio="true"><image><Image url="@../../icons/prdp2.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="btnTabAutoBid" onAction="#onTabAutoBid" prefHeight="44.0" prefWidth="180" style="-fx-background-color: #F5C518; -fx-text-fill: #0A1929; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 7 14 7 14; -fx-background-radius: 4 4 0 0; -fx-border-color: #F5C518; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ TỰ ĐỘNG">
                    <graphic><ImageView fitHeight="18" fitWidth="28.0" preserveRatio="true"><image><Image url="@../../icons/prdp4.png" /></image></ImageView></graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #0c1535; -fx-background: #0c1535; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
            <content>
                <VBox spacing="14" style="-fx-background-color: #0c1535;">
                    <padding><Insets bottom="18" left="24" right="24" top="14" /></padding>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label style="-fx-font-size: 16px; -fx-text-fill: #F5C518;" text="⚙" />
                                <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #F5C518;" text="THIẾT LẬP ĐẤU GIÁ TỰ ĐỘNG" />
                            </HBox>
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #8AADD0;" text="Thiết lập giá tối đa, bật/tắt auto-bid và tự động đặt giá khi bị outbid" />
                        </VBox>
                        <Button fx:id="btnQuayLai" onAction="#onQuayLai" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 14 7 12; -fx-cursor: hand;" text="◀  QUAY LẠI" />
                    </HBox>

                    <VBox spacing="14" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 14 18 16 18;">

                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;">
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="⚙" />
                            <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="THIẾT LẬP AUTO-BID" />
                        </HBox>

                        <GridPane hgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="44" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="20" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="22" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="14" />
                            </columnConstraints>
                            <VBox spacing="5" GridPane.columnIndex="0">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Sản phẩm" />
                                <ComboBox fx:id="cboProduct" maxWidth="Infinity" promptText="Chọn sản phẩm" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-pref-height: 36; -fx-prompt-text-fill: #4A6A8A;" />
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Giá hiện tại" />
                                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 36;">
                                    <Label fx:id="lblCurrentPrice" maxWidth="Infinity" style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 0 7 0; -fx-alignment: CENTER;" text="0" HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-text-fill: #8AADD0; -fx-padding: 0 8 0 0;" text="đ" />
                                </HBox>
                            </VBox>
                            <VBox spacing="5" GridPane.columnIndex="2">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Giá tối đa của bạn" />
                                <HBox alignment="CENTER_LEFT" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 36;">
                                    <TextField fx:id="txtMaxPrice" promptText="Nhập giá tối đa" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #4A6A8A; -fx-font-size: 13px; -fx-padding: 7 4 7 10; -fx-pref-height: 36; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS" />
                                    <Label style="-fx-text-fill: #8AADD0; -fx-padding: 0 8 0 0;" text="đ" />
                                </HBox>
                            </VBox>
                            <VBox alignment="CENTER" spacing="5" GridPane.columnIndex="3">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Auto-bid" />
                                <Button fx:id="btnToggle" maxWidth="Infinity" onAction="#onToggleAutoBid" style="-fx-background-color: #22c55e; -fx-background-radius: 20; -fx-border-color: transparent; -fx-text-fill: #0c1535; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 10 7 10; -fx-cursor: hand; -fx-pref-height: 36;" text="BẬT" />
                            </VBox>
                            <rowConstraints><RowConstraints /></rowConstraints>
                        </GridPane>

                        <GridPane hgap="12">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="33" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="34" />
                            </columnConstraints>
                            <VBox spacing="4" GridPane.columnIndex="0">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Khoảng cách giá mỗi bước" />
                                <HBox style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 36;">
                                    <TextField fx:id="txtStep" promptText="Tối thiểu 500 000" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-padding: 7 4 7 10; -fx-pref-height: 36; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS" />
                                    <Label prefHeight="39.0" prefWidth="15.0" style="-fx-text-fill: #8AADD0; -fx-padding: 0 8 0 0;" text="đ" />
                                </HBox>
                                <Label fx:id="lblStepError" style="-fx-text-fill: #ef4444; -fx-font-size: 11px;" text="" />
                                <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 11px;" text="Số tiền tăng thêm cho mỗi lần đặt giá" />
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="1">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Giới hạn số lần đặt giá" />
                                <HBox style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 36;">
                                    <TextField fx:id="txtMaxTimes" promptText="0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-padding: 7 4 7 10; -fx-pref-height: 36; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS" />
                                    <Label prefHeight="41.0" prefWidth="27.0" style="-fx-text-fill: #8AADD0; -fx-padding: 0 8 0 0;" text="lần" />
                                </HBox>
                                <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 11px;" text="Số lần tối đa hệ thống tự động đặt giá" />
                            </VBox>
                            <VBox spacing="4" GridPane.columnIndex="2">
                                <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Thời gian chờ giữa các lần đặt giá" />
                                <HBox style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 36;">
                                    <TextField fx:id="txtDelay" promptText="0" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-padding: 7 4 7 10; -fx-pref-height: 36; -fx-alignment: CENTER;" HBox.hgrow="ALWAYS" />
                                    <Label prefHeight="35.0" prefWidth="41.0" style="-fx-text-fill: #8AADD0; -fx-padding: 0 8 0 0;" text="giây" />
                                </HBox>
                                <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 11px;" text="Khoảng thời gian chờ giữa các lần đặt giá" />
                            </VBox>
                            <rowConstraints><RowConstraints /></rowConstraints>
                        </GridPane>

                        <HBox alignment="TOP_LEFT" spacing="16" style="-fx-background-color: #162550; -fx-background-radius: 8; -fx-border-color: #1b2f5e; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 12 14 12 14;">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label prefHeight="19.0" prefWidth="193.0" style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold;" text="Cách hoạt động">
                                        <graphic>
                                            <ImageView fitHeight="21.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true">
                                                <image><Image url="@../../icons/chuy.png" /></image>
                                            </ImageView>
                                        </graphic>
                                    </Label>
                                </HBox>
                                <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Hệ thống sẽ tự động đặt giá cao hơn giá hiện tại theo khoảng cách đã thiết lập, cho đến khi đạt giá tối đa hoặc hết số lần đặt giá cho phép." wrapText="true" />
                            </VBox>
                            <HBox alignment="CENTER_LEFT" spacing="20">
                                <VBox spacing="3">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label style="-fx-text-fill: #22c55e; -fx-font-size: 13px;" text="●" />
                                        <Label style="-fx-text-fill: #22c55e; -fx-font-size: 12px; -fx-font-weight: bold;" text="Đang hoạt động" />
                                    </HBox>
                                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 11px;" text="Hệ thống tự động đặt giá" />
                                </VBox>
                                <VBox spacing="3">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label style="-fx-text-fill: #f59e0b; -fx-font-size: 13px;" text="●" />
                                        <Label style="-fx-text-fill: #f59e0b; -fx-font-size: 12px; -fx-font-weight: bold;" text="Tạm dừng" />
                                    </HBox>
                                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 11px;" text="Auto-bid tạm thời bị tắt" />
                                </VBox>
                                <VBox spacing="3">
                                    <HBox alignment="CENTER_LEFT" spacing="6">
                                        <Label style="-fx-text-fill: #ef4444; -fx-font-size: 13px;" text="●" />
                                        <Label style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-font-weight: bold;" text="Đã dừng" />
                                    </HBox>
                                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 11px;" text="Đã đặt giá tối đa hoặc hết lượt" />
                                </VBox>
                            </HBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="0" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 12 16 12 16; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                            <Label prefHeight="20.0" prefWidth="14.0" style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="⏱">
                                <font><Font size="13.0" /></font>
                            </Label>
                            <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="DANH SÁCH AUTO-BID ĐANG HOẠT ĐỘNG" />
                        </HBox>
                        <TableView fx:id="tableAutoBid" maxHeight="300" prefHeight="200" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-table-cell-border-color: #1b2f5e;">
                            <columns>
                                <!-- [THÊM] Cột STT -->
                                <TableColumn fx:id="colStt" minWidth="40" prefWidth="50" text="STT" />
                                <TableColumn fx:id="colProduct" minWidth="140" prefWidth="190" text="Sản phẩm" />
                                <TableColumn fx:id="colCurrentPrice" minWidth="100" prefWidth="120" text="Giá hiện tại" />
                                <TableColumn fx:id="colMaxPrice" minWidth="100" prefWidth="120" text="Giá tối đa" />
                                <TableColumn fx:id="colStep" minWidth="90" prefWidth="110" text="Bước giá" />
                                <TableColumn fx:id="colStatus" minWidth="100" prefWidth="115" text="Trạng thái" />
                                <TableColumn fx:id="colTimes" minWidth="80" prefWidth="100" text="Số lần đặt" />
                                <TableColumn fx:id="colTime" minWidth="90" prefWidth="110" text="Thời gian" />
                                <TableColumn fx:id="colActions" minWidth="70" prefWidth="80" text="" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 13px;" text="Chưa có auto-bid nào. Thiết lập ở trên để bắt đầu." />
                            </placeholder>
                        </TableView>
                    </VBox>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button fx:id="btnRefresh" onAction="#onRefresh" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16 7 12; -fx-cursor: hand;" text="↻  Làm mới" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnHistory" onAction="#onHistory" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16 7 12; -fx-cursor: hand;" text="⏱  Xem lịch sử auto-bid" />
                        <Button fx:id="btnCreate" onAction="#onCreateAutoBid" style="-fx-background-color: #22c55e; -fx-background-radius: 6; -fx-border-color: transparent; -fx-text-fill: #0c1535; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 7 16 7 12; -fx-cursor: hand;" text="＋  Tạo auto-bid mới" />
                    </HBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
