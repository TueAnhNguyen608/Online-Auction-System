<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="650" minWidth="960" style="-fx-background-color: #0c1535;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.bidding.ProductDetailPanel">

    <!-- ===== TOP ===== -->
    <top>
        <VBox style="-fx-background-color: #0c1535;">
            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0e1c40; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0; -fx-min-height: 52; -fx-pref-height: 52;">
                <padding><Insets bottom="10" left="24" right="30" top="10" /></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #F5C518;" text="HỆ THỐNG ĐẤU GIÁ">
                        <graphic>
                            <ImageView fitHeight="36.0" fitWidth="40.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../icons/bua1.png" /></image>
                            </ImageView>
                        </graphic>
                    </Label>
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #0e1c40; -fx-background-radius: 20; -fx-border-color: #2A4A6E; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 4 12 4 8; -fx-cursor: hand;">
                    <ImageView fitHeight="24.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../../icons/user.png" /></image>
                    </ImageView>
                    <Label fx:id="lblUserName" style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold;" text="Admin" />
                    <Label style="-fx-text-fill: #A0C4E8; -fx-font-size: 11px;" text="▾" />
                </HBox>
            </HBox>

            <!-- Tab bar -->
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: #162550; -fx-min-height: 48; -fx-pref-height: 48; -fx-border-color: #11224a; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="0" left="24" right="30" top="0" /></padding>
                <Button fx:id="btnTabDanhSach" onAction="#onTabDanhSach" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 4 4 0 0; -fx-border-color: #1b2f5e; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="DANH SÁCH">
                    <graphic><ImageView fitHeight="22.0" fitWidth="22.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../../icons/1.3.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="btnTabDauGia" onAction="#onTabDauGia" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #F5C518; -fx-text-fill: #0A1929; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 4 4 0 0; -fx-border-color: #F5C518; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ">
                    <graphic><ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../../icons/bua1.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="btnTabAutoBid" onAction="#onTabAutoBid" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16 8 16; -fx-background-radius: 4 4 0 0; -fx-border-color: #1b2f5e; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ TỰ ĐỘNG">
                    <graphic><ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true"><image><Image url="@../../icons/prdp4.png" /></image></ImageView></graphic>
                </Button>
            </HBox>

            <!-- Breadcrumb -->
            <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-background-color: #0c1535; -fx-padding: 8 30 8 24; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                <Button fx:id="btnBack" onAction="#onBack" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #8AADD0; -fx-font-size: 15px; -fx-cursor: hand; -fx-padding: 0 4 0 0;" text="←" />
                <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-cursor: hand;" text="DANH SÁCH SẢN PHẨM" />
                <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 12px;" text="/" />
                <Label style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold;" text="CHI TIẾT SẢN PHẨM" />
            </HBox>
        </VBox>
    </top>

    <!-- ===== CENTER – tỉ lệ 7:3 cố định dù kéo rộng hay hẹp ===== -->
    <center>
        <GridPane prefHeight="600.0" prefWidth="1051.0" style="-fx-background-color: #0c1535;">
            <padding><Insets bottom="16" left="20" right="20" top="14" /></padding>
            <columnConstraints>
                <!-- Left panel: 68% -->
                <ColumnConstraints hgrow="ALWAYS" percentWidth="68" />
                <!-- Khoảng cách giữa 2 panel -->
                <ColumnConstraints maxWidth="16" minWidth="16" prefWidth="16" />
                <!-- Right panel: 32% -->
                <ColumnConstraints hgrow="ALWAYS" percentWidth="32" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>

            <!-- ===== LEFT PANEL ===== -->
            <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">

                <!-- THÔNG TIN SẢN PHẨM -->
                <VBox spacing="0" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1;">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 18 10 18; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="ⓘ" />
                        <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="THÔNG TIN SẢN PHẨM" />
                    </HBox>
                    <VBox spacing="0">
                        <!-- Hàng 1: nền tối -->
                        <HBox spacing="0" style="-fx-background-color: #0e1c40; -fx-padding: 9 16 9 16;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Tên sản phẩm" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblProductName" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold;" text="iPhone 15 Pro Max 1TB" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Hàng 2: nền xen kẽ -->
                        <HBox spacing="0" style="-fx-background-color: #11224a; -fx-padding: 9 16 9 16;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Mô tả" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblDesc" style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Apple chip A17 Pro, RAM 8GB, bộ nhớ 1TB, màn hình Super Retina XDR 6.7 inch, camera 48MP." wrapText="true" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Hàng 3 -->
                        <HBox spacing="0" style="-fx-background-color: #0e1c40; -fx-padding: 9 16 9 16;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Loại sản phẩm" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblCategory" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="Điện thoại" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Hàng 4: nền xen kẽ -->
                        <HBox spacing="0" style="-fx-background-color: #11224a; -fx-padding: 9 16 9 16;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Tình trạng" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblCondition" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="Mới 100%" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Hàng 5 -->
                        <HBox spacing="0" style="-fx-background-color: #0e1c40; -fx-padding: 9 16 9 16;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Người bán" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblSeller" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="Nguyễn Văn A" HBox.hgrow="ALWAYS" />
                        </HBox>
                        <!-- Hàng 6: nền xen kẽ -->
                        <HBox spacing="0" style="-fx-background-color: #11224a; -fx-padding: 9 16 9 16; -fx-background-radius: 0 0 10 10;">
                            <Label minWidth="140" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Ngày đăng" />
                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 0 8 0 0;" text=":" />
                            <Label fx:id="lblPostedDate" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px;" text="01/06/2024 14:30:25" HBox.hgrow="ALWAYS" />
                        </HBox>
                    </VBox>
                </VBox>

                <!-- LỊCH SỬ ĐẤU GIÁ -->
                <VBox spacing="0" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 18 10 18; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="⏱" />
                        <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="LỊCH SỬ ĐẤU GIÁ" />
                    </HBox>
                    <TableView fx:id="tableBidHistory" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-table-cell-border-color: #1b2f5e;" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colBidNo" minWidth="40" prefWidth="50" text="#" />
                            <TableColumn fx:id="colBidder" minWidth="150" prefWidth="229.86664962768555" text="NGƯỜI ĐẤU" />
                            <TableColumn fx:id="colBidAmount" minWidth="140" prefWidth="209.066650390625" text="GIÁ ĐẤU (đ)" />
                            <TableColumn fx:id="colBidTime" minWidth="141.33334350585938" prefWidth="191.73321533203125" text="THỜI GIAN" />
                        </columns>
                        <placeholder>
                            <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 13px;" text="Chưa có lượt đấu giá nào" />
                        </placeholder>
                    </TableView>
                </VBox>
            </VBox>

            <!-- ===== RIGHT PANEL ===== -->
            <VBox spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.vgrow="ALWAYS">

                <!-- CHI TIẾT ĐẤU GIÁ -->
                <VBox spacing="0" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1;" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10 18 10 18; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="⚡" />
                        <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="CHI TIẾT ĐẤU GIÁ" />
                    </HBox>

                    <VBox spacing="0" style="-fx-padding: 10 16 14 16;">
                        <!-- Product image -->
                        <HBox fx:id="imgContainer" alignment="CENTER" style="-fx-padding: 0 0 10 0;">
                            <ImageView fx:id="imgProduct" fitHeight="120.0" fitWidth="240.0" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),8,0,0,2);">
                                <image><Image url="@../../icons/sp1.png" /></image>
                            </ImageView>
                        </HBox>

                        <GridPane hgap="8" vgap="0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 8 0 8 0;" text="Giá hiện tại:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                            <Label fx:id="lblCurrentPrice" style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT; -fx-padding: 8 0 8 0;" text="24.500.000 đ" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                            <Separator style="-fx-background-color: #1b2f5e;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1" />

                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 8 0 8 0;" text="Bước giá tối thiểu:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                            <Label fx:id="lblMinStep" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT; -fx-padding: 8 0 8 0;" text="500.000 đ" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                            <Separator style="-fx-background-color: #1b2f5e;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" />

                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 8 0 8 0;" text="Thời gian còn lại:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                            <Label fx:id="lblTimeLeft" style="-fx-text-fill: #FF6B6B; -fx-font-size: 12px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT; -fx-padding: 8 0 8 0;" text="06 ngày 23:52:47" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                            <Separator style="-fx-background-color: #1b2f5e;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5" />

                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 8 0 8 0;" text="Số lượt trả giá:" GridPane.columnIndex="0" GridPane.rowIndex="6" />
                            <Label fx:id="lblBidCount" style="-fx-text-fill: #FFFFFF; -fx-font-size: 12px; -fx-font-weight: bold; -fx-alignment: CENTER_RIGHT; -fx-padding: 8 0 8 0;" text="5" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                            <Separator style="-fx-background-color: #1b2f5e;" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="7" />

                            <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px; -fx-padding: 8 0 8 0;" text="Trạng thái:" GridPane.columnIndex="0" GridPane.rowIndex="8" />
                            <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 0 8 0;" GridPane.columnIndex="1" GridPane.rowIndex="8">
                                <Label fx:id="lblStatus" style="-fx-text-fill: #0c1535; -fx-background-color: #22c55e; -fx-background-radius: 4; -fx-padding: 2 8 2 8; -fx-font-size: 11px; -fx-font-weight: bold;" text="ĐANG DIỄN RA" />
                            </HBox>

                            <rowConstraints>
                                <RowConstraints /><RowConstraints /><RowConstraints />
                                <RowConstraints /><RowConstraints /><RowConstraints />
                                <RowConstraints /><RowConstraints /><RowConstraints />
                            </rowConstraints>
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- ĐẶT GIÁ CỦA BẠN -->
                <VBox spacing="10" style="-fx-background-color: #0e1c40; -fx-background-radius: 10; -fx-border-color: #1b2f5e; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 12 16 14 16;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #F5C518;" text="⚒" />
                        <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="ĐẶT GIÁ CỦA BẠN" />
                    </HBox>

                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Nhập số tiền bạn muốn đặt" />

                    <HBox spacing="0" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 38;">
                        <TextField fx:id="txtBidAmount" promptText="Ví dụ: 25000000" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #4A6A8A; -fx-font-size: 13px; -fx-padding: 6 8 6 12; -fx-pref-height: 38;" HBox.hgrow="ALWAYS" />
                        <Label prefHeight="40.0" prefWidth="35.0" style="-fx-text-fill: #8AADD0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 0 6 0 6; -fx-alignment: CENTER; -fx-border-color: transparent #1b2f5e transparent transparent; -fx-border-width: 0 1 0 0;" text="đ" />
                        <VBox spacing="0" style="-fx-border-color: transparent;">
                            <Button fx:id="btnUp" onAction="#onBidUp" style="-fx-background-color: #1E3A6E; -fx-background-radius: 0 4 0 0; -fx-border-color: transparent; -fx-text-fill: #A0C4E8; -fx-font-size: 9px; -fx-padding: 2 7 1 7; -fx-cursor: hand; -fx-pref-height: 19; -fx-pref-width: 28;" text="▲" />
                            <Button fx:id="btnDown" onAction="#onBidDown" style="-fx-background-color: #1E3A6E; -fx-background-radius: 0 0 4 0; -fx-border-color: transparent; -fx-text-fill: #A0C4E8; -fx-font-size: 9px; -fx-padding: 1 7 2 7; -fx-cursor: hand; -fx-pref-height: 19; -fx-pref-width: 28;" text="▼" />
                        </VBox>
                    </HBox>

                    <Label fx:id="lblBidWarning" style="-fx-text-fill: #F5C518; -fx-font-size: 11px; -fx-padding: 0 0 0 2;" text="⚠  Giá phải lớn hơn 25.000.000 đ" />

                    <!-- [FIX] Nút nhỏ hơn -->
                    <Button fx:id="btnPlaceBid" maxWidth="Infinity" onAction="#onPlaceBid" prefHeight="48.0" prefWidth="290.0" style="-fx-background-color: #F5C518; -fx-text-fill: #0c1535; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 8 0; -fx-cursor: hand; -fx-background-radius: 6; -fx-border-radius: 6; -fx-effect: dropshadow(gaussian,rgba(245,197,24,0.35),10,0,0,2);" text="ĐẶT GIÁ">
                        <graphic>
                            <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                                <image><Image url="@../../icons/1.1.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </VBox>

            </VBox>
        </GridPane>
    </center>

</BorderPane>
