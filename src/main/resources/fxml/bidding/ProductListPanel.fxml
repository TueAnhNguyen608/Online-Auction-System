<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane minHeight="600" minWidth="900" style="-fx-background-color: #0e1c40;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.bidding.ProductListPanel">

    <!-- ===== HEADER + TAB BAR ===== -->
    <top>
        <VBox style="-fx-background-color: #0c1535; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),10,0,0,3);">

            <!-- Header bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0e1c40; -fx-border-color: #1E3A5F; -fx-border-width: 0 0 1 0; -fx-min-height: 56; -fx-pref-height: 56;">
                <padding><Insets bottom="14" left="24" right="30" top="14" /></padding>

                <!-- Logo + Title -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #F5C518;" text="HỆ THỐNG ĐẤU GIÁ">
                        <graphic>
                            <ImageView fitHeight="44.0" fitWidth="43.0" pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../icons/bua1.png" />
                                </image>
                            </ImageView>
                        </graphic></Label>
                </HBox>

                <Region HBox.hgrow="ALWAYS" />

                <HBox alignment="CENTER" spacing="8" style="-fx-background-color: #0e1c40; -fx-background-radius: 20; -fx-border-color: #2A4A6E; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 5 14 5 10; -fx-cursor: hand;">
                    <ImageView fitHeight="28.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                            <Image url="@../../icons/user.png" />
                        </image>
                    </ImageView>
                    <Label fx:id="lblUserName" style="-fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-font-weight: bold;" text="User" />
                    <Label style="-fx-text-fill: #A0C4E8; -fx-font-size: 11px;" text="▾" />
                </HBox>
            </HBox>

            <HBox fx:id="tabBar" alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: #162550; -fx-min-height: 56; -fx-pref-height: 56; -fx-border-color: #11224a; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="0" left="24" right="30" top="0" /></padding>

                <Button fx:id="btnTabDanhSach" onAction="#onTabDanhSach" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #F5C518; -fx-text-fill: #0A1929; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 20 9 20; -fx-background-radius: 4 4 0 0; -fx-border-color: #F5C518; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="DANH SÁCH">
                    <graphic>
                        <ImageView fitHeight="26.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../icons/1.3.png" />
                            </image>
                        </ImageView>
                    </graphic></Button>

                <Button fx:id="btnTabDauGia" onAction="#onTabDauGia" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color:#0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 20 9 20; -fx-background-radius: 4 4 0 0; -fx-border-color: #2A5090; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../icons/prdp2.png" />
                            </image>
                        </ImageView>
                    </graphic></Button>

                <Button fx:id="btnTabAutoBid" onAction="#onTabAutoBid" prefHeight="44.0" prefWidth="180.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 9 20 9 20; -fx-background-radius: 4 4 0 0; -fx-border-color: #2A5090; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="ĐẤU GIÁ TỰ ĐỘNG">
                    <graphic>
                        <ImageView fitHeight="28.0" fitWidth="25.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../icons/prdp4.png" />
                            </image>
                        </ImageView>
                    </graphic></Button>
            </HBox>

        </VBox>
    </top>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="12" style="-fx-background-color: #0c1535;">
            <padding><Insets bottom="5" left="30" right="30" top="22" /></padding>
            <!-- Content header row -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label prefHeight="20.0" prefWidth="181.0" style="-fx-text-fill: #F5C518; -fx-font-size: 14px; -fx-font-weight: bold;" text=" DANH SÁCH SẢN PHẨM" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnQuayLai" onAction="#onQuayLai" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #162550; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 18 7 14; -fx-cursor: hand;" text="◀   QUAY LẠI" />
            </HBox>

            <HBox alignment="CENTER_LEFT" maxWidth="640" prefWidth="640" spacing="0" style="-fx-background-color: #162550; -fx-background-radius: 8; -fx-border-color: #3A6090; -fx-border-radius: 8; -fx-border-width: 1; -fx-pref-height: 42; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),4,0,0,1);">
                <TextField fx:id="txtSearch" onAction="#onSearch" promptText="Tìm kiếm sản phẩm..." style="-fx-background-color: transparent ; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #7AAAD0; -fx-font-size: 13px; -fx-padding: 8 12 8 16; -fx-pref-height: 42;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSearch" onAction="#onSearch" style="-fx-background-color: #162550; -fx-background-radius: 0 8 8 0; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-padding: 8 18 8 16; -fx-pref-height: 42; -fx-cursor: hand;" text="🔍" />
            </HBox>

            <!-- [THÊM] -fx-selection-bar: transparent để tắt màu xanh mặc định của JavaFX -->
            <TableView fx:id="tableProducts" maxHeight="420" prefHeight="420" style="-fx-background-color: transparent; -fx-border-color: #2A4A6E; -fx-border-radius: 8; -fx-border-width: 1; -fx-table-cell-border-color: #2A4A6E;-fx-table-header-background: #1E4268; -fx-selection-bar: transparent; -fx-selection-bar-non-focused: transparent;" VBox.vgrow="NEVER">
                <columns>
                    <TableColumn fx:id="colStt" minWidth="60" prefWidth="70" text="ID" />
                    <TableColumn fx:id="colName" minWidth="200" prefWidth="360" text="TÊN SẢN PHẨM" />
                    <TableColumn fx:id="colPrice" minWidth="150" prefWidth="190" text="GIÁ KHỞI ĐIỂM" />
                    <TableColumn fx:id="colSeller" minWidth="100" prefWidth="140" text="SELLER" />
                    <TableColumn fx:id="colTime" minWidth="100" prefWidth="140" text="THỜI GIAN" />
                </columns>
                <placeholder>
                    <Label style="-fx-text-fill: #4A6A8A; -fx-font-size: 14px;" text="Không có sản phẩm nào" />
                </placeholder>
            </TableView>

            <!-- Pagination -->
            <HBox fx:id="paginationBox" alignment="CENTER" spacing="6" style="-fx-padding: 8 0 4 0;">
                <Button fx:id="btnFirst" onAction="#onFirstPage" styleClass="page-nav-btn" text="«" />
                <Button fx:id="btnPrev" onAction="#onPrevPage" styleClass="page-nav-btn" text="‹" />
                <Button fx:id="btnNext" onAction="#onNextPage" styleClass="page-nav-btn" text="›" />
                <Button fx:id="btnLast" onAction="#onLastPage" styleClass="page-nav-btn" text="»" />
            </HBox>

        </VBox>
    </center>

</BorderPane>
