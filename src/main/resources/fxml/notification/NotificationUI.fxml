<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="493.0" prefWidth="871.0" style="-fx-background-color: #0c1535;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.ui.notification.NotificationUI">

    <!-- ===== HEADER ===== -->
    <top>
        <VBox style="-fx-background-color: #0c1535;">
            <!-- Header bar -->
            <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: #0e1c40; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0; -fx-min-height: 56; -fx-pref-height: 56;">
                <padding><Insets bottom="10" left="24" right="24" top="10" /></padding>
                <!-- Logo + Title -->
                <HBox alignment="CENTER_LEFT" spacing="10" HBox.hgrow="ALWAYS">
                    <ImageView fitHeight="28" fitWidth="28" preserveRatio="true">
                        <image><Image url="@../../icons/thongbao.png" /></image>
                    </ImageView>
                    <Label style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #F5C518;" text="THÔNG BÁO" />
                </HBox>
                <Region HBox.hgrow="ALWAYS" />
                <!-- Nút quay lại ở góc phải header -->
                <Button fx:id="btnQuayLai" onAction="#onQuayLai" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 7 14 7 12; -fx-cursor: hand;" text="◀  QUAY LẠI" />
            </HBox>

            <!-- Tab bar -->
            <HBox alignment="CENTER_LEFT" spacing="4" style="-fx-background-color: #162550; -fx-min-height: 48; -fx-pref-height: 48; -fx-border-color: #11224a; -fx-border-width: 0 0 1 0;">
                <padding><Insets bottom="0" left="24" right="24" top="0" /></padding>
                <Button fx:id="btnTabDanhSach" onAction="#onTabDanhSach" prefHeight="37.0" prefWidth="218.0" style="-fx-background-color: #F5C518; -fx-text-fill: #0A1929; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 18 8 14; -fx-background-radius: 4 4 0 0; -fx-border-color: #F5C518; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="DANH SÁCH THÔNG BÁO">
                    <graphic><ImageView fitHeight="29.0" fitWidth="21.0" preserveRatio="true"><image><Image url="@../../icons/thongbao.png" /></image></ImageView></graphic>
                </Button>
                <Button fx:id="btnTabCaiDat" onAction="#onTabCaiDat" prefHeight="37.0" prefWidth="218.0" style="-fx-background-color: #0e1c40; -fx-text-fill: #CCDFF5; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 18 8 14; -fx-background-radius: 4 4 0 0; -fx-border-color: #1b2f5e; -fx-border-radius: 4 4 0 0; -fx-border-width: 1; -fx-cursor: hand;" text="CÀI ĐẶT THÔNG BÁO">
                    <graphic><ImageView fitHeight="20" fitWidth="20" preserveRatio="true"><image><Image url="@../../icons/edit.png" /></image></ImageView></graphic>
                </Button>
                <Region HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </top>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <HBox spacing="0" style="-fx-background-color: #0c1535;">

            <!-- ===== LEFT: BỘ LỌC ===== -->
            <VBox minWidth="220" prefWidth="260" spacing="14" style="-fx-background-color: #0e1c40; -fx-border-color: transparent #1b2f5e transparent transparent; -fx-border-width: 0 1 0 0; -fx-padding: 18 16 18 16;">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <ImageView fitHeight="18.0" fitWidth="66.0" preserveRatio="true">
                        <image><Image url="@../../icons/1.3.png" /></image>
                    </ImageView>
                    <Label style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="BỘ LỌC" />
                </HBox>

                <!-- Loại thông báo -->
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Loại thông báo" />
                    <ComboBox fx:id="cboLoai" maxWidth="Infinity" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-pref-height: 36;" value="Tất cả" />
                </VBox>

                <!-- Trạng thái -->
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Trạng thái" />
                    <ComboBox fx:id="cboTrangThai" maxWidth="Infinity" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-pref-height: 36;" value="Tất cả" />
                </VBox>

                <!-- Thời gian -->
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #C0D8F0; -fx-font-size: 12px;" text="Thời gian" />
                    <ComboBox fx:id="cboThoiGian" maxWidth="Infinity" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #FFFFFF; -fx-font-size: 13px; -fx-pref-height: 36;" value="7 ngày gần đây" />
                </VBox>

                <!-- Date range -->
                <HBox spacing="8">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 11px;" text="Từ ngày" />
                        <DatePicker fx:id="dpTuNgay" maxWidth="Infinity" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 34;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 11px;" text="Đến ngày" />
                        <DatePicker fx:id="dpDenNgay" maxWidth="Infinity" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 34;" />
                    </VBox>
                </HBox>

                <!-- Nút lọc -->
                <HBox spacing="10">
                    <Button fx:id="btnDatLai" maxWidth="Infinity" onAction="#onDatLai" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 8 0; -fx-cursor: hand;" text="Đặt lại" HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnLoc" maxWidth="Infinity" onAction="#onLoc" style="-fx-background-color: #F5C518; -fx-background-radius: 6; -fx-border-color: #F5C518; -fx-border-radius: 6; -fx-border-width: 1; -fx-text-fill: #0c1535; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 8 0 8 0; -fx-cursor: hand;" text="Lọc" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>

            <!-- ===== RIGHT: DANH SÁCH ===== -->
            <VBox spacing="0" style="-fx-background-color: #0c1535;" HBox.hgrow="ALWAYS">

                <!-- Header danh sách + search -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 14 20 12 20; -fx-border-color: #1b2f5e; -fx-border-width: 0 0 1 0;">
                    <ImageView fitHeight="23.0" fitWidth="43.0" preserveRatio="true">
                        <image><Image url="@../../icons/thongbao.png" /></image>
                    </ImageView>
                    <Label prefHeight="19.0" prefWidth="165.0" style="-fx-text-fill: #F5C518; -fx-font-size: 13px; -fx-font-weight: bold;" text="DANH SÁCH THÔNG BÁO" />
                    <Label fx:id="lblUnreadDot" style="-fx-text-fill: #F5C518; -fx-font-size: 10px;" text="●" />
                    <Region HBox.hgrow="ALWAYS" />
                    <!-- Search -->
                    <HBox alignment="CENTER_LEFT" spacing="0" style="-fx-background-color: #162550; -fx-background-radius: 6; -fx-border-color: #2A5090; -fx-border-radius: 6; -fx-border-width: 1; -fx-pref-height: 34; -fx-pref-width: 220;">
                        <TextField fx:id="txtSearch" promptText="Tìm kiếm thông báo..." style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #FFFFFF; -fx-prompt-text-fill: #4A6A8A; -fx-font-size: 12px; -fx-padding: 6 6 6 10;" HBox.hgrow="ALWAYS" />
                        <Button onAction="#onSearch" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-text-fill: #8AADD0; -fx-font-size: 13px; -fx-cursor: hand; -fx-padding: 4 8 4 4;" text="🔍" />
                    </HBox>
                </HBox>

                <!-- Danh sách thông báo -->
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #0c1535; -fx-background: #0c1535; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="vboxNotifications" spacing="0" style="-fx-background-color: #0c1535;" />
                    </content>
                </ScrollPane>

                <!-- Footer pagination -->
                <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 10 20 10 20; -fx-border-color: #1b2f5e; -fx-border-width: 1 0 0 0; -fx-background-color: #0e1c40;">
                    <Label fx:id="lblPageInfo" style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Hiển thị 1 đến 8 trong tổng số 24 thông báo" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="Hiển thị" />
                    <ComboBox fx:id="cboPageSize" prefWidth="70" style="-fx-background-color: #162550; -fx-border-color: #2A5090; -fx-border-radius: 4; -fx-border-width: 1; -fx-text-fill: #FFFFFF; -fx-font-size: 12px;" value="10" />
                    <Label style="-fx-text-fill: #8AADD0; -fx-font-size: 12px;" text="trên mỗi trang" />
                    <Button fx:id="btnPageFirst" onAction="#onFirstPage" style="-fx-background-color: #162550; -fx-background-radius: 4; -fx-border-color: #2A5090; -fx-border-radius: 4; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-pref-width: 30; -fx-pref-height: 30; -fx-cursor: hand;" text="⟨" />
                    <HBox fx:id="paginationBox" alignment="CENTER" spacing="4" />
                    <Button fx:id="btnPageLast" onAction="#onLastPage" style="-fx-background-color: #162550; -fx-background-radius: 4; -fx-border-color: #2A5090; -fx-border-radius: 4; -fx-border-width: 1; -fx-text-fill: #CCDFF5; -fx-pref-width: 30; -fx-pref-height: 30; -fx-cursor: hand;" text="⟩" />
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
