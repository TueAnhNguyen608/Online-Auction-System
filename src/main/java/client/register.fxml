<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox spacing="15" alignment="CENTER"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="client.RegisterController"
      style="-fx-background-image: url('bg.jpg'); -fx-background-size: cover; -fx-background-position: center; -fx-background-repeat: no-repeat;">

    <VBox spacing="15" alignment="CENTER"
          style="-fx-background-color: rgba(255, 255, 255, 0.25);">

        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>

        <VBox spacing="14" alignment="CENTER"
              style="-fx-background-color: rgba(255, 255, 255, 0.85); -fx-background-radius: 32px; -fx-padding: 30px 40px 40px 40px; -fx-pref-width: 380px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 25, 0, 0, 10); -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1.5px; -fx-border-radius: 32px;">

            <Label text="🎯" style="-fx-font-size: 56px; -fx-text-fill: #e67e22;"/>

            <Label text="ĐẤU GIÁ">
                <font>
                    <Font name="Segoe UI Black" size="22"/>
                </font>
                <style>-fx-font-weight: bold; -fx-text-fill: #1a365d; -fx-letter-spacing: 2px;</style>
            </Label>

            <Label text="ĐĂNG KÝ TÀI KHOẢN"
                   style="-fx-font-size: 11px; -fx-text-fill: #4a5568; -fx-padding: 0 0 8 0;"/>

            <TextField fx:id="usernameField" promptText="TÊN ĐĂNG NHẬP" maxWidth="300"
                       style="-fx-padding: 11px; -fx-background-radius: 28px; -fx-border-radius: 28px; -fx-border-color: #cbd5e0; -fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>

            <TextField fx:id="emailField" promptText="EMAIL" maxWidth="300"
                       style="-fx-padding: 11px; -fx-background-radius: 28px; -fx-border-radius: 28px; -fx-border-color: #cbd5e0; -fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>

            <PasswordField fx:id="passwordField" promptText="MẬT KHẨU" maxWidth="300"
                           style="-fx-padding: 11px; -fx-background-radius: 28px; -fx-border-radius: 28px; -fx-border-color: #cbd5e0; -fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>

            <PasswordField fx:id="confirmPasswordField" promptText="XÁC NHẬN MẬT KHẨU" maxWidth="300"
                           style="-fx-padding: 11px; -fx-background-radius: 28px; -fx-border-radius: 28px; -fx-border-color: #cbd5e0; -fx-background-color: rgba(255,255,255,0.9); -fx-font-size: 12px;"/>

            <ComboBox fx:id="roleComboBox" maxWidth="300"
                      style="-fx-padding: 9px; -fx-background-radius: 28px; -fx-border-radius: 28px; -fx-border-color: #cbd5e0; -fx-background-color: rgba(255,255,255,0.9);"/>

            <Button text="ĐĂNG KÝ" onAction="#handleRegister" maxWidth="300"
                    style="-fx-background-color: #2c5282; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-padding: 11px; -fx-background-radius: 28px; -fx-cursor: hand;"/>

            <Hyperlink text="← QUAY LẠI ĐĂNG NHẬP" onAction="#handleBackToLogin"
                       style="-fx-text-fill: #3182ce; -fx-font-weight: bold; -fx-font-size: 11px; -fx-underline: false;"/>
        </VBox>
    </VBox>
</VBox>