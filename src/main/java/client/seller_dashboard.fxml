<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="client.SellerDashboardController"
            style="-fx-background-image: url('bg.jpg'); -fx-background-size: cover; -fx-background-position: center; -fx-background-repeat: no-repeat;">

    <top>
        <VBox>
            <MenuBar style="-fx-background-color: rgba(255,255,255,0.5); -fx-border-color: rgba(255,255,255,0.6); -fx-border-width: 0 0 1 0;">
                <Menu text="QUẢN LÝ">
                    <MenuItem text="TẠO SẢN PHẨM" onAction="#handleCreateProduct"/>
                    <MenuItem text="BẮT ĐẦU ĐẤU GIÁ" onAction="#handleStartAuction"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="LÀM MỚI" onAction="#handleRefresh"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="ĐĂNG XUẤT" onAction="#handleLogout"/>
                </Menu>
                <Menu text="TRỢ GIÚP">
                    <MenuItem text="HƯỚNG DẪN" onAction="#handleHelp"/>
                    <MenuItem text="THÔNG TIN" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>

            <HBox spacing="15" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(255,255,255,0.4); -fx-padding: 12px 20px; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 0 0 1 0;">
                <Label text="🎯" style="-fx-font-size: 28px; -fx-text-fill: #e67e22;"/>
                <Label fx:id="welcomeLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a365d;">
                    <font>
                        <Font name="Segoe UI Semibold" size="14"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" style="-fx-text-fill: #2c5282; -fx-font-size: 11px; -fx-padding: 5px 14px; -fx-background-color: rgba(255,255,255,0.7); -fx-background-radius: 20px;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane style="-fx-padding: 20px; -fx-background-color: transparent; -fx-tab-min-height: 38px;">
            <Tab text="SẢN PHẨM" closable="false">
                <VBox spacing="10" style="-fx-padding: 15px;">
                    <TableView fx:id="productsTable"
                               style="-fx-background-color: rgba(255,255,255,0.7); -fx-border-color: rgba(255,255,255,0.8); -fx-border-radius: 16px; -fx-background-radius: 16px;">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                            <TableColumn fx:id="colName" text="TÊN SẢN PHẨM" prefWidth="250"/>
                            <TableColumn fx:id="colDescription" text="MÔ TẢ" prefWidth="350"/>
                            <TableColumn fx:id="colStartPrice" text="GIÁ KHỞI ĐIỂM" prefWidth="130"/>
                            <TableColumn fx:id="colStatus" text="TRẠNG THÁI" prefWidth="120"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
            <Tab text="ĐANG ĐẤU GIÁ" closable="false">
                <VBox spacing="10" style="-fx-padding: 15px;">
                    <TableView fx:id="activeAuctionsTable"
                               style="-fx-background-color: rgba(255,255,255,0.7); -fx-border-color: rgba(255,255,255,0.8); -fx-border-radius: 16px; -fx-background-radius: 16px;">
                        <columns>
                            <TableColumn text="SẢN PHẨM" prefWidth="250"/>
                            <TableColumn text="GIÁ HIỆN TẠI" prefWidth="130"/>
                            <TableColumn text="THỜI GIAN CÒN LẠI" prefWidth="150"/>
                            <TableColumn text="SỐ LƯỢT ĐẶT" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <Label text="© 2025 ĐẤU GIÁ"
               style="-fx-padding: 12px; -fx-background-color: rgba(255,255,255,0.4); -fx-text-fill: #4a5568; -fx-font-size: 11px; -fx-alignment: center; -fx-border-color: rgba(255,255,255,0.5); -fx-border-width: 1 0 0 0;"/>
    </bottom>
</BorderPane>